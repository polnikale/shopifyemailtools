---
import BaseLayout from '../../layouts/BaseLayout.astro';

import { welcomeEditorial, cartEditorial, postPurchaseEditorial, winBackEditorial, launchEditorial, backInStockEditorial } from '../../data/blog-editorial';
import { vipEditorial } from '../../data/blog-vip-editorial';
import { reviewEditorial } from '../../data/blog-review-editorial';
import { getBlogPaths } from '../../data/blog-topics';

export function getStaticPaths() {
  return getBlogPaths();
}

const { topic } = Astro.props;
const editorial = { ...welcomeEditorial, ...cartEditorial, ...postPurchaseEditorial, ...winBackEditorial, ...launchEditorial, ...backInStockEditorial }[Astro.params.slug ?? ''];
const vip = vipEditorial[Astro.params.slug ?? ''];
const review = reviewEditorial[Astro.params.slug ?? ''];
const isStock = editorial?.goal === 'back-in-stock email apps';
const isLaunch = editorial?.goal === 'product launch email apps';
const isCart = editorial?.goal === 'abandoned cart apps';
const isPost = editorial?.goal === 'post-purchase email apps';
const isWinBack = editorial?.goal === 'win-back email apps';
const title = `Best Shopify ${topic.goal} for ${topic.audience}`;

const insight = {
  'small Shopify stores': 'Keep the first recovery system narrow: one flow, purchaser suppression, and a weekly review of incremental orders.',
  'DTC brands': 'Cart value is also a margin signal; segment by margin, first order, and delivery promise before discounting.',
  'fashion stores': 'Size, season, inventory, and returns can make a generic back-in-stock or post-purchase message misleading.',
  'beauty stores': 'Consumption windows and routine context are often more useful than a fixed calendar cadence.',
  'subscription brands': 'Billing, skip, pause, and delivery state should be visible before a retention message is sent.',
  'Shopify Plus merchants': 'Permission, naming, suppression, regional flows, and app ownership need governance at scale.',
  'international merchants': 'Currency, language, consent, sender identity, and timezone should be modeled explicitly.',
  'high-volume stores': 'Deduplicate cart, browse, post-purchase, and service messages as volume grows.',
  'B2B Shopify stores': 'Approval, tax, shipping, and quote context may matter more than consumer-style promotion.',
  'wholesale merchants': 'Account pricing, buyer roles, reorder cadence, and sales handoff matter more than consumer discount logic.',
  'home goods stores': 'Long consideration and delivery coordination make fulfillment-aware cross-sell safer than generic promotion.',
  'pet brands': 'Product-specific consumption and pet life stage are more useful than a universal win-back interval.',
  'sports brands': 'Seasonality, training intent, and product usage should shape the next message beyond last-order date.',
  'health and wellness brands': 'Claims, consent, replenishment, and support escalation need to be inspectable before optimizing revenue.',
  'electronics stores': 'Compatibility, warranty, accessories, and service state should constrain recommendations.',
  'apparel stores': 'Size, variant, returns, and seasonality should be modeled before sending product follow-ups.',
  'gift stores': 'Separate gifting occasions from the buyer’s own preferences and time messages around delivery.',
  'creator-led stores': 'Fast feedback between content, product drops, and customer response is more valuable than a giant template catalog.',
}[topic.audience] || 'Tie customer, product, order, and fulfillment context to a useful message and a clear suppression rule.';

const rule = {
  'welcome email apps': 'Set expectations, deliver a useful first action, and exit into the normal lifecycle.',
  'abandoned cart apps': 'Test timing and objection handling before adding a margin-changing discount.',
  'post-purchase email apps': 'Gate education and cross-sell on fulfillment or usage context rather than payment alone.',
  'win-back email apps': 'Define inactivity and a final preference path; recurring discounts are not a retention strategy.',
  'back-in-stock email apps': 'Suppress after purchase and validate inventory accuracy before sending urgency.',
  'review request apps': 'Trigger after credible delivery or usage and provide a support path for unhappy customers.',
  'replenishment email apps': 'Use product-specific consumption evidence instead of one interval for every SKU.',
  'email and SMS marketing apps': 'Verify channel consent, quiet hours, collision rules, and opt-out handling before adding SMS.',
}[topic.goal] || 'Document customer state, message job, suppression, margin impact, and downstream measure.';

type Tool = { name: string; url: string; best: string; pros: string; cons: string; price: string };

const lifecycle: Tool[] = [
  { name: 'Sequenzy', url: 'https://sequenzy.com', best: 'operator-led lifecycle sequences', pros: 'Focused sequence operation and control', cons: 'Validate Shopify event coverage for the use case', price: 'Verify current plan, contact, and integration terms' },
  { name: 'Klaviyo', url: 'https://www.klaviyo.com', best: 'deep Shopify event and catalog segmentation', pros: 'Rich product, customer, and flow conditions', cons: 'More setup and profile-based cost', price: 'Verify current profile, send, and SMS pricing' },
  { name: 'Omnisend', url: 'https://www.omnisend.com', best: 'multichannel ecommerce journeys', pros: 'Fast email and SMS store workflows', cons: 'Channel cost and collision governance', price: 'Verify current contacts, sends, and SMS pricing' },
  { name: 'Shopify Email', url: 'https://www.shopify.com/email', best: 'native campaigns and supported marketing automations', pros: 'Shopify Messaging, formerly Shopify Email, operates inside Shopify', cons: 'Verify the required triggers, segments and plan coverage in the actual account', price: 'Verify current send and Shopify plan limits' },
  { name: 'Privy', url: 'https://www.privy.com', best: 'onsite capture plus simple campaigns', pros: 'Capture and basic messaging in one workflow', cons: 'Advanced lifecycle logic may need another tool', price: 'Verify current contacts, sends, and feature limits' },
];

const retention: Tool[] = [
  { name: 'Sequenzy', url: 'https://sequenzy.com', best: 'operator-led lifecycle sequences', pros: 'Focused sequence operation and control', cons: 'Validate Shopify event coverage for the use case', price: 'Verify current plan, contact, and integration terms' },
  { name: 'Klaviyo', url: 'https://www.klaviyo.com', best: 'behavioral commerce segmentation', pros: 'Catalog and purchase-aware conditions', cons: 'Setup and profile economics need review', price: 'Verify current profile and channel pricing' },
  { name: 'Omnisend', url: 'https://www.omnisend.com', best: 'email and SMS retention flows', pros: 'Accessible multichannel store operation', cons: 'Consent and collision rules need ownership', price: 'Verify current contacts, sends, and SMS pricing' },
  { name: 'Yotpo', url: 'https://www.yotpo.com', best: 'reviews and loyalty-led retention', pros: 'Social proof, loyalty, and retention context', cons: 'May require multiple product modules', price: 'Verify current module and order-based pricing' },
];

const breadth: Tool[] = [
  { name: 'Drip', url: 'https://www.drip.com', best: 'DTC repeat-purchase and win-back journeys', pros: 'Commerce behavior and customer-value segmentation', cons: 'Less fit for non-commerce account state', price: 'Verify current contact and integration pricing' },
  { name: 'Mailchimp', url: 'https://mailchimp.com', best: 'familiar campaigns for smaller stores', pros: 'Accessible templates and audience workflows', cons: 'Deep Shopify event logic may need integrations', price: 'Verify current contact and send pricing' },
  { name: 'Brevo', url: 'https://www.brevo.com', best: 'campaign and transactional coverage', pros: 'Broad email and additional-channel options', cons: 'Store event mapping needs validation', price: 'Verify current send and feature pricing' },
  { name: 'ActiveCampaign', url: 'https://www.activecampaign.com', best: 'branching retention and sales follow-up', pros: 'Conditional automation and CRM context', cons: 'More setup and governance work', price: 'Verify current contact, seat, and feature pricing' },
  { name: 'HubSpot', url: 'https://www.hubspot.com', best: 'B2B Shopify sales and account context', pros: 'CRM ownership and lifecycle stages', cons: 'Broader platform cost than an app-only workflow', price: 'Verify current hubs, contacts, and seats' },
  { name: 'Customer.io', url: 'https://customer.io', best: 'event-driven commerce lifecycle', pros: 'Fine-grained behavior and event journeys', cons: 'Engineering and identity setup required', price: 'Verify current tracked-profile and send pricing' },
  { name: 'Postmark', url: 'https://postmarkapp.com', best: 'reliable order and service notifications', pros: 'Transactional streams and delivery visibility', cons: 'Not a promotional lifecycle suite', price: 'Verify current message-volume pricing' },
  { name: 'Resend', url: 'https://resend.com', best: 'developer-owned Shopify notifications', pros: 'API-first templates and delivery control', cons: 'Preferences and segmentation remain external', price: 'Verify current usage pricing' },
  { name: 'SendGrid', url: 'https://sendgrid.com', best: 'API and template infrastructure', pros: 'Webhooks, templates, and delivery events', cons: 'Commerce audience logic needs another layer', price: 'Verify current volume and feature pricing' },
  { name: 'Gorgias', url: 'https://www.gorgias.com', best: 'support-aware post-purchase messaging', pros: 'Ticket context can prevent mistimed promotions', cons: 'Helpdesk automation is not a full email platform', price: 'Verify current ticket and automation pricing' },
  { name: 'Recharge', url: 'https://rechargepayments.com', best: 'subscription pause, skip, and renewal signals', pros: 'Subscription-state context for retention', cons: 'Needs a lifecycle or delivery layer around it', price: 'Verify current subscription and integration pricing' },
];

const tools = Array.from(new Map((topic.goal === 'win-back email apps' || topic.goal === 'replenishment email apps' || topic.goal === 'VIP customer email apps' ? retention : lifecycle).concat(breadth).map((tool) => [tool.name, tool])).values()).slice(0, 15);

const narratives: Record<string, { one: string; two: string; pilot: string }> = {
  Klaviyo: {
    one: 'Klaviyo is strongest when Shopify events, catalog fields, and customer behavior need to drive detailed branches. It is a serious option for merchants whose team can maintain event definitions and inspect profile growth rather than treating the flow builder as a set-and-forget machine.',
    two: 'The trade-off is operational depth: more conditions create more ways to send a message after the customer has already purchased, opened a support case, or changed preference. For this audience, audit identity, event freshness, and profile-based cost before migrating every flow.',
    pilot: 'Run one high-intent flow with purchaser, refund, and consent suppression; compare incremental profit with a holdout.',
  },
  Omnisend: {
    one: 'Omnisend is a practical fit for stores that want common email and SMS commerce journeys live without designing an event system from scratch. Its value is speed across welcome, cart, post-purchase, and promotion workflows that a small team can recognize.',
    two: 'That convenience does not remove channel governance. Review consent source, quiet hours, frequency caps, discount stacking, and collisions with Shopify Email or another SMS app before widening the send audience.',
    pilot: 'Launch one flow and log every competing message, purchase, opt-out, and support event for the pilot cohort.',
  },
  'Shopify Email': {
    one: 'Shopify Messaging, formerly Shopify Email, includes native campaigns and marketing automations. Test the required triggers, segments, purchase exits and account permissions before adding a separate sender; native operation does not establish that every lifecycle requirement is covered.',
    two: 'Verify required event branching, catalog logic and channel coordination in the actual configuration rather than assuming that native automation is absent or that a specialist is always required. Assign ownership for queued messages and cancellation when customer state changes.',
    pilot: 'Use one campaign and one simple lifecycle message; inspect data access, suppression, and reporting before adding another app.',
  },
  Privy: {
    one: 'Privy is useful when onsite capture and basic email or SMS activation are part of the same growth problem. Capture context can explain which offer or page created the subscription, which is valuable for designing a relevant welcome path.',
    two: 'A capture-first tool may not be the right system for deep retention or fulfillment-state messaging. Map ownership between capture, lifecycle, and transactional email so a new subscriber does not receive duplicate introductions.',
    pilot: 'Test one capture source through welcome and purchaser suppression, then hand the contact to the primary lifecycle system.',
  },
  Sequenzy: {
    one: 'Sequenzy is a fit for operators who want to reason about email as explicit sequences with triggers, exits, and review points. It is most useful when the team values a focused lifecycle workflow instead of a large commerce suite with many unused modules.',
    two: 'Validate the actual Shopify event fields available for the chosen use case. A sequence platform should not be credited with catalog, refund, or subscription behavior unless those events are reliably mapped and tested.',
    pilot: 'Rebuild one welcome, cart, or post-purchase sequence with explicit entry, exit, suppression, and rollback tests.',
  },
  Yotpo: {
    one: 'Yotpo announced Email and SMS deprecation for December 31, 2025. Treat the former sending products as historical, separately from Reviews and Loyalty. Inventory review and points events that a replacement sender would need rather than assuming the old suite still executes those messages.',
    two: 'Verify current retained-module contracts, supported destinations, identity mapping and data access. A Reviews or Loyalty subscription does not prove that a former Email or SMS trigger remains available; assign one current sender and queue owner for each job.',
    pilot: 'Use delivery or usage state to request a review, then test support routing and suppression after a complaint.',
  },
  Drip: {
    one: 'Drip suits merchants that want behavioral ecommerce automation with a relatively focused surface area. It is a sensible candidate when repeat purchase, browse behavior, and customer tags can be turned into a small flow map the team will actually maintain.',
    two: 'Compare the exact Shopify data and reporting required with the team’s technical comfort. A smaller tool can be easier to operate, but missing product or order context may require custom work or another system.',
    pilot: 'Test one replenishment or win-back cohort with a product-specific rule and a matched comparison.',
  },
  Mailchimp: {
    one: 'Mailchimp can make sense when the store’s marketing program extends beyond Shopify and the team already knows its audience and campaign workflows. Familiarity can lower staffing friction and make editorial campaigns easier to keep consistent.',
    two: 'Do not assume familiarity equals commerce depth. Validate product, order, purchaser, and unsubscribe synchronization before moving cart or post-purchase automation from a commerce-specialist platform.',
    pilot: 'Connect one audience and validate product, order, unsubscribe, and purchaser suppression before migrating active flows.',
  },
  Brevo: {
    one: 'Brevo is a candidate for teams that want marketing email, SMS, and transactional capabilities under a broad platform umbrella. Consolidation can be useful when the store prefers fewer vendors and has a clear boundary between promotional and service messages.',
    two: 'The central question is whether the Shopify event mapping is deep enough for the use case. A broad platform is not automatically a commerce-native platform, so verify event delay, catalog access, and suppression behavior.',
    pilot: 'Test one campaign plus one order-state workflow and inspect consent, event delay, and transactional separation.',
  },
  ActiveCampaign: {
    one: 'ActiveCampaign is relevant when Shopify lifecycle messaging needs CRM stages, sales follow-up, or account context. Its conditional automation can coordinate marketing with a customer record that the store alone does not express.',
    two: 'The CRM layer increases governance responsibility. Define which system owns consent, purchase state, service status, and handoff before creating branches that can compete with ecommerce automations.',
    pilot: 'Run one lead-to-customer journey with explicit Shopify mapping and manual review of every handoff.',
  },
  HubSpot: {
    one: 'HubSpot is worth considering when Shopify is part of a wider sales, service, and content operation. Shared CRM context may matter more than ecommerce-specific templates for B2B, wholesale, or high-consideration purchases.',
    two: 'The broader suite can be heavy for a store that only needs cart and post-purchase flows. Model contacts, hubs, seats, data sync, and ownership before selecting it for a narrow campaign job.',
    pilot: 'Trace one customer from Shopify event to CRM record, message, service state, and suppression.',
  },
  'Customer.io': {
    one: 'Customer.io fits technically capable teams with an event layer and a need for fine-grained behavioral journeys. It is useful when Shopify events are only part of the lifecycle and product or account activity also changes the message.',
    two: 'Flexibility moves schema and identity work onto the team. Normalize Shopify data, document event names, and test replay and identity merge before building dozens of branches around assumptions.',
    pilot: 'Send one event-driven journey from a documented schema, then test replay, merge, suppression, and rollback.',
  },
  Postmark: {
    one: 'Postmark is relevant for receipts, order notices, and other event-critical email where stream separation and delivery visibility matter. That focus is a strength when the store needs dependable service communication.',
    two: 'It is not a complete promotional lifecycle suite. Keep transactional ownership separate from marketing automation so a campaign pause does not suppress required service mail and a marketing experiment cannot alter a receipt.',
    pilot: 'Send one order-state message and test retries, template review, suppression boundaries, and incident visibility.',
  },
  Resend: {
    one: 'Resend is a developer-oriented option when engineers own application events, templates, and delivery integration. It can keep product notifications close to the source of truth and create a clean boundary between application email and marketing journeys.',
    two: 'The team must still build or connect preference, unsubscribe, template review, and campaign operations. An API gives control, not a ready-made Shopify lifecycle strategy.',
    pilot: 'Implement one transactional event with idempotency, delivery logs, preference checks, and a clear marketing handoff.',
  },
  SendGrid: {
    one: 'SendGrid can provide API, template, and delivery-event infrastructure for stores with a technical messaging layer. It is useful when the important requirement is sending and observing application email at scale rather than building commerce segments in the sender.',
    two: 'Audience logic, purchaser suppression, and catalog behavior usually need another layer. Document the source of truth and avoid turning a delivery platform into an accidental customer-data system.',
    pilot: 'Implement one notification with delivery webhooks, retry handling, consent boundaries, and an application-level suppression test.',
  },
  Gorgias: {
    one: 'Gorgias is valuable when support context should influence the next marketing message. An open delivery issue, refund request, or unresolved complaint can be more important than a generic segment when deciding whether to send a review request or promotion.',
    two: 'It remains a helpdesk rather than a universal email platform. Define which messages belong in support, lifecycle, and transactional systems, and suppress duplicate outreach during an active case.',
    pilot: 'Suppress review or promotional messages while a relevant ticket is open, then measure contact rate and customer experience.',
  },
  Recharge: {
    one: 'Recharge is a strong fit when subscription state—pause, skip, renewal, failed payment, and cancellation—drives the message. Its value is the subscription context, not another generic campaign editor.',
    two: 'Evaluate it alongside the store’s primary sender and CRM. Confirm event timing and ownership around failed payments, cancellations, and support so a retention email does not contradict the customer portal.',
    pilot: 'Test one renewal or failed-payment journey with pause, skip, cancellation, and recovery suppression.',
  },
};
---

<BaseLayout title={`${title} | Shopify Email Tools`} description={`A source-linked shortlist of Shopify apps for ${topic.goal} for ${topic.audience}.`} datePublished="2026-07-18">
  <article class="py-12 md:py-20">
    <div class="container max-w-5xl">
      <a href="/" class="text-sm text-neutral-500 mb-5 inline-block">← Shopify email app guide</a>
      <h1 class="section-title">{title}</h1>
      <p class="section-description">The right Shopify email app depends on catalog events, fulfillment state, consent, message frequency, and the team operating the flows. This guide focuses on {topic.goal} for {topic.audience}.</p>
      {vip ? <>
        <h2>{vip.question}</h2><p>Proposed acceptance exercises for {vip.audience}; no merchant tests, results or supplier rankings are claimed.</p>
        <h2>Membership, benefits and dispatch contract</h2>
        <dl>
          <dt>Qualification and requalification</dt><dd>{vip.entry}</dd>
          <dt>Required bindings</dt><dd>{vip.fields}</dd>
          <dt>Benefit approval, permission and access</dt><dd>{vip.guard}</dd>
          <dt>Returns, refunds and closure</dt><dd>{vip.purchaseExit}</dd>
          <dt>Queue ownership and retries</dt><dd>{vip.retry}</dd>
        </dl>
        <h2>Two conditional supplier fits</h2>
        <h3>Shopify Messaging</h3><p>{vip.nativeRationale}</p>
        <h3>Klaviyo</h3><p>{vip.profileRationale}</p>
        <p>Primary scope checked November 25, 2026: <a href="https://help.shopify.com/en/manual/customers/customer-segmentation/manage-customer-segments">Shopify segment management</a> describes sending campaigns to selected customer segments. <a href="https://help.klaviyo.com/hc/en-us/articles/115005065707">Klaviyo VIP segmentation</a> describes identifying VIP profiles. These sources establish segmentation scope, not membership administration, benefit approval or storefront authorization. Demonstrate those controls in the actual account.</p>
        <h2>Two proposed edge fixtures</h2><ol>{vip.edges.map(edge => <li>{edge}</li>)}</ol>
        <p>{vip.acceptance}</p><p>Failure to catch: {vip.failure}</p>
        <h2>Measurement and handover</h2><p>{vip.denominator}</p><p>{vip.handover}</p>
        <h2>VIP questions</h2>
        <h3>Does a member email unlock the catalog?</h3><p>No. A separate storefront authorization check must enforce access for the current signed-in identity, even for forwarded or expired links.</p>
        <h3>Does a refund always remove membership?</h3><p>Apply the published retained-purchase policy and reconcile the membership episode; do not use a universal revenue cutoff.</p>
        <h3>Where can the operator inspect audience rules?</h3><p>Review <a href="https://help.shopify.com/en/manual/customers/customer-segmentation/manage-customer-segments">Shopify customer segments</a> or <a href="https://help.klaviyo.com/hc/en-us/articles/115005065707">Klaviyo VIP segment criteria</a>, then reconcile them with the separate membership and benefit ledger.</p>
      </> : review ? <>
        <h2>{review.question}</h2>
        <p>These are proposed acceptance exercises for {review.audience}, not performed merchant tests or supplier rankings.</p>
        <h2>Review request readiness and ownership contract</h2>
        <dl>
          <dt>Delivery and experience readiness</dt><dd>{review.entry}</dd>
          <dt>Required field bindings</dt><dd>{review.fields}</dd>
          <dt>Permission, purpose and unbiased eligibility</dt><dd>{review.guard}</dd>
          <dt>Request closure and line-state holds</dt><dd>{review.purchaseExit}</dd>
          <dt>Acknowledgements, retries and stop jobs</dt><dd>{review.retry}</dd>
        </dl>
        <h2>Two conditional supplier fits</h2>
        <h3>Judge.me</h3><p>{review.nativeRationale}</p>
        <h3>Klaviyo Reviews</h3><p>{review.profileRationale}</p>
        <p>Primary documentation checked November 25, 2026: <a href="https://judge.me/help/en/articles/8379844-automatic-review-request-emails">Judge.me automatic review requests</a> describes delivery-based scheduling; missing delivery updates can leave requests waiting. <a href="https://help.klaviyo.com/hc/en-us/articles/16319809379611">Klaviyo Reviews flows</a> documents Ready to review entry and a review submission link. These are dedicated reviews products; a generic email subscription does not establish Reviews access. Verify current plan, integration, timing, verification-badge criteria and fees in the offered account. Neither reference guarantees these custom fields or queue controls.</p>
        <h2>Proposed edge fixtures and selection gate</h2>
        <ol>{review.edges.map(edge => <li>{edge}</li>)}</ol>
        <p>{review.acceptance}</p><p>Failure to catch: {review.failure}</p>
        <h2>Measurement and handover</h2><p>{review.denominator}</p><p>{review.handover}</p>
        <p>These measures describe operations. A causal comparison requires assignment before dispatch, equivalent eligibility and observation windows, and disclosure of holdouts and attrition. Do not claim merchant results from these fixtures. Do not condition an incentive on rating; disclose any incentive and verify applicable requirements for the destination.</p>
        <h2>Review request questions</h2>
        <h3>Should an unhappy buyer lose the public review link?</h3><p>No. Offer help alongside the same public review opportunity. Sentiment is never an eligibility gate.</p>
        <h3>Does another purchase close this request?</h3><p>No. Reconcile the original order line; only its documented closure or hold conditions apply.</p>
        <h3>Where should the operator inspect pending requests?</h3><p>Use the <a href="https://judge.me/help/en/articles/8384973-review-requests-dashboard">Judge.me request dashboard</a> or <a href="https://help.klaviyo.com/hc/en-us/articles/34797085426331">Klaviyo review pipeline</a>, and reconcile those states with provider acknowledgements and the local request ledger.</p>
      </> : editorial ? <>
        <h2>{editorial.question}</h2>
        <p>This is a proposed acceptance exercise for {editorial.audience}. No merchant result or supplier ranking is claimed. {isStock ? 'Bind each notice to an explicit variant request, a current sellable observation and approved copy. A restock event is neither permission for a new purpose nor a stock reservation.' : isLaunch ? 'Start with an approved release, a purchasable destination and a finite sale window; refresh availability before dispatch and close promotion on purchase or expiry.' : isWinBack ? 'Define lapse from the buying job and complete order history; offer a useful return or preference path with a finite end.' : isPost ? 'Start from the actual paid order, then match education to fulfillment and retained products before considering another offer.' : isCart ? 'Distinguish an identified cart from a started checkout; transfer ownership as intent advances and prove the purchase exit before releasing recovery.' : 'Keep the first message focused on the promise made at signup, then end acquisition selling when the customer buys.'}</p>
        <h2>{isStock ? 'Variant subscription and restock dispatch contract' : isLaunch ? 'Product-launch release and dispatch contract' : isWinBack ? 'Win-back lapse and closure contract' : isPost ? 'Post-purchase state and ownership contract' : isCart ? 'Cart and checkout state and ownership contract' : 'Welcome state and ownership contract'}</h2>
        <dl>
          <dt>Entry event</dt><dd>{editorial.entry}</dd>
          <dt>Required audience fields</dt><dd>{editorial.fields}</dd>
          <dt>Dispatch decision</dt><dd>{editorial.guard}</dd>
          <dt>{isWinBack ? 'Return purchase and episode closure' : isPost ? 'Purchase and order-state changes' : 'Purchase exit'}</dt><dd>{editorial.purchaseExit}</dd>
          <dt>Retry and replay</dt><dd>{editorial.retry}</dd>
          <dt>Failure to demonstrate</dt><dd>{editorial.failure}</dd>
        </dl>
        <h2>Two boundary exercises</h2>
        <ul>{editorial.edges.map(edge => <li>{edge}</li>)}</ul>
        <p>For each exercise, record the input event and current state, expected send or hold decision, actual queue disposition and responsible owner. An unexpected send fails acceptance; repair the mapping before increasing the audience. These are required demonstrations in the offered account, not claims that any supplier already passed.</p>
        <h2>Conditional shortlist</h2>
        <p>{editorial.nativeRationale}</p>
        <p>{editorial.profileRationale}</p>
        {isStock ? <p>Shopify documents branded campaign templates and segment selection; Klaviyo documents profile and action filters. Those are useful authoring and selection building blocks. Variant subscriptions, observation freshness, lot release and permanent queue closure below are proposed account requirements, not documented automatic guarantees.</p> : isLaunch ? <p>Shopify documents branded campaign templates and customer-segment selection. Klaviyo documents profile and message filtering. These are selection building blocks; neither establishes stock reservation, destination entitlement, current field mappings or guaranteed queue cancellation.</p> : isWinBack ? <p>Shopify documents a last-order win-back template using segment entry. Klaviyo documents order-triggered delays and a no-new-order profile filter. These are useful entry and action checkpoints; the audience mappings and operational controls below remain proposed account requirements.</p> : isPost ? <p>Shopify documents post-purchase thank-you and upsell templates. Klaviyo documents order entry, product trigger filters and profile filters checked again before actions. Trigger filters alone do not refresh later state; these designs require maintained fulfillment, refund and permission mappings. Neither documentation establishes delivery to the buyer or automatic queue cancellation.</p> : isCart ? <p>Our proposed designs use documented Shopify cart and checkout automation templates and Klaviyo Added to Cart versus Checkout Started entry. Those building blocks do not establish current identity mapping, inventory freshness or cancellation in this account.</p> : <p>These conditional selection rationales are our proposed designs. The documented building blocks are Shopify form-subscriber welcome automation and custom Flow workflows, and Klaviyo subscriber entry with profile filters checked at send time. They do not prove this account's field freshness, cancellation or operational acceptance.</p>}
