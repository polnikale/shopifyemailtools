---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const app = appBySlug('smsbump')!;
const path = '/apps/smsbump';
const title = pageTitle(site, 'apps/smsbump');
const desc = description(site, 'apps/smsbump');

const faqs = [
  {
    question: 'Is SMSBump a full Shopify email marketing platform?',
    answer: 'No. SMSBump is SMS and MMS within Yotpo ecosystem. Cart recovery texts, popup opt-in, segmented campaigns. Email lifecycle belongs in Yotpo Email, Sequenzy, or Klaviyo. Choose SMSBump when Yotpo reviews or loyalty already active.',
  },
  {
    question: 'SMSBump vs Postscript for Shopify SMS?',
    answer: 'SMSBump is a historical Yotpo SMS/MMS product name. Yotpo announced Email and SMS deprecation for December 31, 2025; this does not describe a Reviews or Loyalty shutdown. For replacement selection, compare supported destinations using current official documentation and an account-specific demonstration of consent import, replies, suppression, reporting and export access. Do not select a deprecated service because another Yotpo module remains in use.',
  },
  {
    question: 'Does SMSBump MMS improve cart recovery on every catalog?',
    answer: 'No catalog guarantees an MMS advantage. Propose a randomized SMS-versus-MMS experiment among recipients eligible for both treatments, with comparable offers and observation windows. Compare delivered-message costs, reply labor, refunds and contribution margin; clicks and attributed orders alone do not establish incremental benefit. Choose sample size and duration from expected effects and uncertainty, not a fixed calendar.',
  },
  {
    question: 'How much does SMSBump cost during sale weeks?',
    answer: 'Do not use historical SMSBump estimates as a current quote. Model the same baseline and peak workload at each replacement: destination countries, billable segments, encoding, MMS, carrier charges, platform minimums, number rental, support and reply labor. Obtain current account-specific terms and reconcile forecasts against invoices. A low average month can conceal a costly launch week.',
  },
  {
    question: 'Can SMSBump replace Yotpo Email?',
    answer: 'No — complementary modules. SMSBump owns SMS; Yotpo Email owns email. Some merchants run SMSBump plus Sequenzy email when Yotpo Email depth insufficient.',
  },
  {
    question: 'Does SMSBump include list growth popups?',
    answer: 'Historical capture features do not establish current availability or lawful permission. For a replacement, verify supported forms and export fields with official documentation and a safe test. Preserve the disclosure version, source, timestamp, purpose and channel evidence. Email permission, a purchase or Reviews/Loyalty membership alone does not authorize promotional SMS; apply current suppression and regional requirements before dispatch.',
  },
  {
    question: 'When should merchants outside Yotpo choose SMSBump?',
    answer: 'Treat SMSBump as a historical migration subject rather than a new purchase option, whether or not Reviews or Loyalty remains useful. Compare supported replacements on your required countries, verified consent transfer, reply routing, queued-job cancellation and matched all-in costs. Keeping another Yotpo product does not establish a replacement messaging integration or permission transfer.',
  },
  {
    question: 'How coordinate SMSBump with Sequenzy email cart flows?',
    answer: 'Document channel priority: email touches first, SMS branch when unopened after 4–6 hours if opted in. Suppress SMS when email cart touch sent within prior 2 hours unless testing with holdout.',
  },
  {
    question: 'What is the biggest SMSBump mistake?',
    answer: 'Treating historical features, fabricated results or attributed revenue as proof of current availability and profitable lift. Establish replacement access and queue ownership first, then test suppression, purchase exits, replay deduplication and replies before activation. If testing MMS, use a predeclared comparison and report uncertainty alongside all-in costs rather than assuming a visual catalog guarantees gains.',
  },
];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />

  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/apps" class="text-sm font-bold text-[#9a5b16] hover:text-[#24170f]">← All tool reviews</a>
      <p class="catalog-kicker mt-6">Yotpo ecosystem SMS · Rank #20</p>
      <h1 class="hero-title mt-5 max-w-5xl">{app.name} review for Shopify stores</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[#4a2d17]">
        SMSBump is the SMS module merchants reach for when Yotpo already owns reviews, loyalty, or both — cart recovery texts, MMS product images, keyword opt-in, and segmented broadcasts inside one vendor relationship instead of bolting Postscript onto a fragmented stack. It is not an email platform. Lifecycle newsletters, welcome branching, and replenishment orchestration live in Yotpo Email, Sequenzy, or Klaviyo while SMSBump handles the pocket channel where limited-run urgency actually converts.
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-[#5d3a1d]">
        This historical review uses proposed vinyl, keyboard and tea scenarios; it does not report merchant experiments. Yotpo announced Email and SMS deprecation for December 31, 2025, separately from Reviews and Loyalty. Existing catalog ratings and price fields are historical, unverified metadata rather than current purchasing evidence. Confirm export access and replacement arrangements directly before planning a cutover.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/apps/yotpo-email-sms">Yotpo Email review</a>
        <a class="btn btn-secondary" href="/apps/postscript">Postscript review</a>
        <a class="btn btn-secondary" href="/compare/klaviyo-vs-postscript">Klaviyo vs Postscript</a>
      </div>
    </div>
  </section>

  <section class="container pb-12">
    <TldrBox
      title="Verdict: SMSBump for Shopify"
      picks={[
        { label: 'Channel', tool: 'SMS + MMS', reason: 'Cart recovery and campaigns — email lives elsewhere.' },
        { label: 'Ecosystem', tool: 'Yotpo suite', reason: 'Best when reviews or loyalty modules already active.' },
        { label: 'Edge', tool: 'MMS recovery', reason: 'Album art and product renders in recovery texts.' },
        { label: 'Tradeoff', tool: 'SMS economics', reason: 'MMS multiplies costs — holdout test before defaulting.' },
        { label: 'Alternative', tool: 'Postscript', reason: 'When SMS-only without Yotpo modules on invoice.' },
      ]}
    />

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Suite cohesion versus SMS specialization</h2>
      <p>
        For a historical SMS migration, compare replacement candidates on documented country coverage, reply assignment, consent evidence and reporting definitions. A vinyl label could test whether cover artwork changes purchases, using a randomized eligible audience and the same offer. No 12% versus 8% result is established here; an image click advantage would not itself establish causal revenue lift or justify higher total cost.
      </p>
      <p>
        The mechanical keyboard brand was not on Yotpo. They ran a thirty-day recovery test: Postscript won on compliance dashboard depth, reply handling for plate-compatibility questions, and cleaner attribution when paired with Sequenzy email. SMSBump lost honestly — ecosystem bundling does not beat specialization when you are paying for reviews module you do not use. Bundle inertia is a real merchant failure mode; evaluate net cost after subtracting modules you would buy anyway.
      </p>
      <p>
        A proposed vinyl-and-tea experiment should stratify the audience by category before random assignment. Keep message purpose and offer comparable, include recipients who do not purchase in the analysis, and measure contribution after delivery fees, discounts, refunds and reply labor. Do not claim savings or equivalent recovery from an unspecified sample; report the estimated difference and uncertainty.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Shopify integration and event coverage</h2>
      <p>
        For a replacement Shopify integration, inspect the actual cart, checkout, order and consent payloads and their identifiers. Verify current purpose and channel permission, suppression and purchase state again before dispatch. Assign a single sending system and queue owner for each purpose; cancel obsolete queued reminders and deduplicate replayed events using stable business identifiers. A shared vendor relationship does not prove these controls exist.
      </p>
      <p>
        <strong>Strong fits:</strong> Historical requirements to carry into replacement evaluation include visual recovery messages, opted-in restock alerts, review-request coordination and traceable capture forms. Demonstrate each required path in the intended account and market instead of treating old feature descriptions as current availability.
      </p>
      <p>
        <strong>Limits:</strong> A deprecated messaging service is not a new deployment candidate. Compare supported replacements against actual email, SMS, reply handling and audit needs; do not infer enterprise readiness or legal compliance from a vendor category. Reviews and Loyalty continuity does not establish messaging availability.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Pricing scenarios with real message volume</h2>
      <p>
        Historical message volumes below are workload examples, not current SMSBump prices. Obtain matched replacement quotes and record currencies, taxes, carrier fees, segment rules, minimum commitments and support scope. Include migration work, operator time and reply handling as well as delivery charges.
      </p>
      <p>
        <strong>Baseline month — 3,200 SMS, 400 MMS:</strong> Price this illustrative workload for the same recipient countries, encoding and billable segment counts at each candidate. Allocate only genuinely required suite costs consistently. No monthly dollar total or cheaper provider is established without a quote and an invoice reconciliation.
      </p>
      <p>
        <strong>Launch week — 9,000 SMS, 1,200 MMS:</strong> Model this illustrative peak separately from baseline, including burst limits, overages, support coverage and staffing for replies. Check how credits and minimum commitments interact with the rest of the month; do not imply that this workload has an observed historical bill.
      </p>
      <p>
        <strong>Holdout lesson — tea tins:</strong> Propose SMS versus MMS random assignment within the eligible tea audience, with a predeclared outcome and observation window. A small or inconclusive sample cannot establish equivalence. Report contribution margin and uncertainty after all matched costs rather than assuming a universal MMS fee multiplier.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Four workflow tests on Shopify</h2>
      <p>
        <strong>1. MMS cart — vinyl $78 cart.</strong> Use the cart value as an illustrative input, not a minimum eligibility rule. In a safe replacement test, confirm artwork rendering, destination eligibility and current purchase exits. Then test SMS versus MMS with comparable offers and a predeclared margin outcome; no click or recovery result is claimed.
      </p>
      <p>
        <strong>2. Sale week volume — tea MMS audit.</strong> Forecast the illustrative 9,000 SMS and 1,200 MMS workload from billable segments and destination-specific terms. Reconcile delivery, refund and reply costs. Decide whether MMS merits another experiment from uncertainty and economic relevance rather than an invented peak bill.
      </p>
      <p>
        <strong>3. Yotpo reviews coordination.</strong> Keep continuing Reviews and Loyalty jobs separate from the retired Email/SMS service. Inventory each system and pending queue, assign an owner per message purpose, and verify current order state before a review request or recovery message is dispatched. A calendar alone cannot cancel an already queued job.
      </p>
      <p>
        <strong>4. Postscript comparison — keyboards.</strong> Compare supported candidates using the same plate-compatibility reply scenario and consent evidence. Test routing, operator response ownership, suppression and reporting definitions without duplicate live recovery sends. Set the evaluation duration from representative traffic and uncertainty, with no claimed winner.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Newsletters, lifecycle email, and SMS coordination</h2>
      <p>
        SMSBump does not send editorial newsletters or post-purchase education sequences — coordinate with Yotpo Email, Sequenzy, or Klaviyo for those jobs. Channel priority document required: customer in Sequenzy cart email touch two should not receive SMSBump cart MMS one hour later unless explicit test with holdout measurement. Merchants running Sequenzy email plus SMSBump SMS during Yotpo migration period need weekly collision audit.
      </p>
      <p>
        Map order updates, promotional recovery and subscription billing assistance as separate purposes with named system and queue owners. Confirm required permission and content for each purpose rather than borrowing promotional eligibility from a transactional relationship. Cancel stale jobs after a purchase or resolution and deduplicate retried subscription or order events.
      </p>
      <p>
        For a proposed limited-run drop, separate waitlist confirmation from promotional early access. Verify the relevant channel and purpose permission at dispatch, current opt-out state and the agreed contact policy across senders. Choose timing and frequency from customer expectations, applicable rules and measured complaints; no universal monthly cap or collapse deadline is established.
      </p>
    </div>

    <div class="ledger-card mb-12">
      <p class="catalog-kicker">Operating contract</p>
      <h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">SMSBump discipline on Shopify</h2>
      <p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">
        Run a properly designed SMS-versus-MMS comparison on a supported replacement, after migration controls pass. Category-specific hypotheses need evidence and matched costs; an attractive product image does not guarantee profitable incremental orders.
      </p>
      <ul class="mt-4 space-y-3 text-[17px] leading-8 text-[#4a2d17]">
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Inventory continuing Reviews/Loyalty and replacement messaging queues, with one owner per purpose</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Evaluate recovery contribution after matched delivery, discounts, refunds and reply labor; no universal cart threshold</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Check current purchase and suppression state at dispatch; cancel stale queued recovery jobs and deduplicate replays</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Preserve channel and purpose permission evidence, disclosure version, source, timestamp and opt-outs; verify applicable requirements</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Evaluate supported replacement access, representative workloads and rollback controls before any commitment</li>
      </ul>
    </div>

    <div class="grid gap-8 lg:grid-cols-2 mb-12">
      <div class="card">
        <p class="catalog-kicker">Pros</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          {app.strengths.map((s) => <li class="flex gap-2"><span class="text-[#9a5b16]">+</span>{s}</li>)}
        </ul>
      </div>
      <div class="card">
        <p class="catalog-kicker">Cons</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          {app.limits.map((l) => <li class="flex gap-2"><span class="text-[#9a5b16]">−</span>{l}</li>)}
        </ul>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2 mb-12">
      <div class="ledger-card">
        <p class="catalog-kicker">Who should buy</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Existing Reviews or Loyalty users still need a supported messaging replacement</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Visual catalogs need controlled evidence of profitable MMS lift rather than assumed benefit</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>A shared dashboard requires demonstrated integration; suite membership is not proof</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Order volume and SMS list share alone do not determine fit or eligibility</li>
        </ul>
      </div>
      <div class="ledger-card">
        <p class="catalog-kicker">Who should skip</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Do not buy a deprecated messaging product as a new deployment</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Demonstrate reply routing and staffing in each supported candidate</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>For email-only requirements, assess supported email tools and native Shopify Messaging automation scope</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Use matched economics and uncertainty rather than a universal order-volume cutoff</li>
        </ul>
      </div>
    </div>

    <div class="card mb-12">
      <p class="catalog-kicker">Compare alternatives</p>
      <h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Related Shopify email tools</h2>
      <ul class="mt-6 space-y-3 text-lg font-bold">
        <li><a class="link" href="/apps/yotpo-email-sms">Yotpo Email & SMS review</a></li>
        <li><a class="link" href="/apps/postscript">Postscript review</a></li>
        <li><a class="link" href="/use-cases/abandoned-cart">Abandoned cart guide</a></li>
        <li><a class="link" href="/compare/klaviyo-vs-postscript">Klaviyo vs Postscript</a></li>
      </ul>
    </div>
  </section>

<!-- TARGETED_EXPANSION_v4 -->

  <section class="container py-12">
    <div class="prose-shopify">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Yotpo loyalty tier SMS coordination</h2>
      <p>
        Proposed loyalty test: compare early-access treatments among eligible members while preserving purpose and channel permission. Tier membership is not SMS permission, and tier cohorts differ in prior purchase propensity. Randomize within comparable strata and report contribution margin with uncertainty; no 3.2× conversion result is claimed. Continuing Loyalty availability does not revive Email/SMS.
      </p>
    </div>
  </section>

<!-- TARGETED_EXPANSION_v5 -->
  <section class="container py-12"><div class="card"><p class="catalog-kicker">Keyword campaigns</p><h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Drop keyword opt-in for vinyl VIP</h2><p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">
        Proposed restock scenario: collect explicit permission for the stated pressing and channel using a supported replacement form or keyword route. Verify identifier mapping and retention of consent evidence before dispatch. Compare incremental purchases under a predeclared design; no 340-opt-in or 41% conversion result is established. Retire or redirect the campaign carefully without treating silence as broader marketing permission.
      </p></div></section>

  <section class="container py-12">
    <div class="prose-shopify">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Three merchant stacks with SMSBump in production</h2>
      <p>
        <strong>Stack A — Vinyl label on full Yotpo suite.</strong> Reviews module collects jacket photos post-delivery; loyalty points accrue on repeat pressings; SMSBump handles cart MMS and keyword restock alerts. Sequenzy owns welcome and post-purchase education because Yotpo Email depth felt thin for pre-order branching. Weekly ops calendar maps all four modules — collision without calendar is how subscribers get review request, loyalty tier email, and cart SMS within ninety minutes. The label recovered 11% of abandoned cart revenue on MMS paths where cover art rendered; plain SMS held at 7% on same SKU holdout. Finance approved SMSBump retention on incremental MMS lift for visual SKUs only, not store-wide default.
      </p>
      <p>
        <strong>Stack B — Board game publisher, Yotpo reviews only.</strong> A proposed replacement evaluation can retain Reviews while testing launch alerts and component-count reply routing separately. Confirm supported integration and export access rather than inferring suite interoperability. Give each eligible purpose one sender and queue owner, and compare labor and delivery costs without running competing live cart reminders.
      </p>
      <p>
        <strong>Stack C — Artisan coffee roaster, accidental MMS overspend.</strong> This is a proposed audit scenario, not an observed loss. Compare SMS and MMS among eligible coffee customers using the same offer, with sufficient evidence to report uncertainty. Include delivery and reply costs, refunds and discounts. No $110 saving or equivalent conversion is established; preserve campaign-specific permission when evaluating a new sender.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Workflow tests: cart recovery, compliance, and collision</h2>
      <p>
        <strong>Test 1 — Cart recovery timing versus Sequenzy email.</strong> Mechanical keyboard shop paired Sequenzy email touch one at ninety minutes with SMSBump MMS at four hours when email unopened. Holdout cohort received email-only path. Combined path recovered 9.2% of abandoned cart GMV; email-only 6.8%. Incremental SMS justified on carts over $180 only — sub-threshold carts lost margin after message fees. Document minimum cart value in ops wiki, not buried in flow settings.
      </p>
      <p>
        <strong>Test 2 — TCPA consent audit before import.</strong> Use a hypothetical legacy export to inspect source, timestamp, disclosure, channel and purpose evidence alongside opt-outs. Quarantine records with missing evidence and determine an appropriate lawful resolution; do not assume an unsolicited re-permission text is allowed. No vendor block or six-day delay is claimed. Verify destination mapping and fresh suppression before dispatch.
      </p>
      <p>
        <strong>Test 3 — Quiet hours on international subscribers.</strong> Test local scheduling, daylight-saving changes, unknown locations and destination coverage in the intended replacement. Assign a conservative handling rule for uncertain location and confirm applicable restrictions before activation. No complaint spike is reported. A displayed schedule does not prove a queued job will recheck eligibility at send time.
      </p>
      <p>
        <strong>Test 4 — Yotpo review collision.</strong> Simulate overlapping review requests and cart events without live sends. A purchase must exit stale recovery paths, while review eligibility follows its own purpose rules. Inspect every sender queue, cancel obsolete jobs and deduplicate retries. Moving a calendar entry does not cancel a previously scheduled message.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Buyer checklist before annual SMSBump commitment</h2>
      <p>
        Use this checklist for migration from historical SMSBump to a supported replacement. Resolve each critical control individually; a score cannot compensate for missing consent, stale queues or unverified access.
      </p>
      <ul>
        <li>Can continuing Reviews/Loyalty needs be documented separately from the retired messaging service?</li>
        <li>Does a predeclared MMS comparison measure contribution and uncertainty among eligible recipients?</li>
        <li>Are economic assumptions and current purchase exits documented and tested?</li>
        <li>Is one sender and queue owner assigned per purpose, with stale-job cancellation and replay deduplication?</li>
        <li>Can channel and purpose permission evidence and current suppression be traced per recipient?</li>
        <li>Are email and SMS purposes, owners and dispatch checks documented separately?</li>
        <li>Were supported replacements evaluated on comparable workloads without duplicate live recovery sends?</li>
        <li>Are peak and baseline costs matched, including carrier fees, minimums, migration and reply labor?</li>
      </ul>
      <p>
        Do not aggregate these checks into a purchase score. Missing permission, unsafe queue ownership or inability to cancel obsolete recovery jobs blocks activation regardless of other answers. Treat incomplete current vendor evidence as a verification task and retain a rollback owner and an exception log.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Rank context: where SMSBump sits in the Shopify SMS layer</h2>
      <p>
        Catalog ranks are editorial metadata, not evidence that a retired service is available or that one replacement delivers better compliance or incremental recovery. Compare supported candidates against verified country coverage, reply workflows, consent exports, current suppression and all-in costs. Keep Reviews and Loyalty scope separate from the Email/SMS sunset.
      </p>
      <p>
        Graduation path: when order volume exceeds 1,200 monthly and collision rules exceed one hour weekly maintenance, evaluate consolidating SMS into Klaviyo or Postscript plus Sequenzy email — not because SMSBump failed, but because stack complexity outgrew founder bandwidth. Document keyword campaign performance and MMS SKU rules before migration; those insights transfer even when vendor changes.
      </p>
    </div>
  </section>

  <section class="container py-12">
    <div class="ledger-card">
      <p class="catalog-kicker">90-day proof plan</p>
      <h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Prove SMSBump ROI before suite renewal</h2>
      <ul class="mt-4 space-y-3 text-[17px] leading-8 text-[#4a2d17]">
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Design: predeclare eligible audiences, treatments, margin outcomes, uncertainty and stopping rules</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Safety: test current permission, suppression, purchase exits, local scheduling and stale-job cancellation</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Pilot: test one supported restock route with campaign-specific permission and replay deduplication</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Ownership: inventory continuing Reviews/Loyalty and replacement queues; investigate collisions and exceptions</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Decision: compare causal contribution and matched all-in costs after representative observation; no fixed renewal deadline</li>
      </ul>
    </div>
  </section>

  <section class="container pb-8">
    <div class="flex flex-wrap gap-4 text-sm font-bold">
      <a class="link" href="/apps">All Shopify email tools →</a>
      <a class="link" href="/compare">Comparison hub →</a>
      <a class="link" href="/for/food-and-beverage">Food & beverage stores →</a>
    </div>
  </section>

  <FaqSection faqs={faqs} title="SMSBump Shopify FAQ" />
</BaseLayout>
