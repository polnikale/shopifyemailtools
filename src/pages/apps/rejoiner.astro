---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import TldrBox from '../../components/TldrBox.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site, description, pageTitle } from '../../content';
import { appBySlug } from '../../data/apps';

const app = appBySlug('rejoiner')!;
const path = '/apps/rejoiner';
const title = pageTitle(site, 'apps/rejoiner');
const desc = description(site, 'apps/rejoiner');

const faqs = [
  {
    question: 'Is Rejoiner a self-serve email platform?',
    answer: 'Evaluate software access and any managed services separately. Require a written scope for strategy, creative, implementation and approvals; do not assume a tier includes them.',
  },
  {
    question: 'Rejoiner vs agency?',
    answer: 'Compare the same deliverables, implementation, messaging fees, creative rights, internal review and reply labor over the same period. A managed proposal is not inherently cheaper than an agency.',
  },
  {
    question: 'Rejoiner vs Sequenzy?',
    answer: 'Rejoiner sells human expertise bundled. Sequenzy sells agent-first playbooks and pay-per-email for teams willing to own ops.',
  },
  {
    question: 'Pricing model?',
    answer: 'Request a current written quote covering software, service hours, messaging, onboarding, overages and exit costs. Compare matched workloads with hiring and agency alternatives.',
  },
  {
    question: 'Cart recovery specialty?',
    answer: 'Evaluate cart recovery using eligible events, current purchase and suppression checks, one sender per message, and a feasible holdout. Attributed recoveries alone do not establish incremental margin.',
  },
  {
    question: 'Who should skip?',
    answer: 'Skip a managed scope when its deliverables do not address a staffing gap or its matched all-in cost exceeds plausible incremental contribution. Order volume alone is not a cutoff.',
  },
  {
    question: 'Subscription box fit?',
    answer: 'A subscription program can evaluate shipment previews, pause or skip events and risk-cohort messaging. Confirm the integration and contracted work; neither churn timing nor improvement is assumed.',
  },
  {
    question: 'Exit risk?',
    answer: 'Assign an internal owner and agree export formats, access, creative rights and transition support in writing. Verify what can be transferred before relying on a handoff.',
  },
  {
    question: 'SMS included?',
    answer: 'Confirm current channel availability and service scope in writing. Evaluate email and SMS permission separately by purpose, with current suppression checks and documented sender ownership.',
  },
];
---

<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />

  <section class="relative overflow-hidden py-16 md:py-24">
    <div class="container">
      <a href="/apps" class="text-sm font-bold text-[#9a5b16] hover:text-[#24170f]">← All tool reviews</a>
      <p class="catalog-kicker mt-6">Managed lifecycle · Rank #14</p>
      <h1 class="hero-title mt-5 max-w-5xl">{app.name} review for Shopify stores</h1>
      <p class="mt-7 max-w-3xl text-xl leading-9 text-[#4a2d17]">
        Evaluate Rejoiner as a potential software and services engagement for a Shopify retention program. Request a current scope covering cart recovery, creative support, implementation, account access and approvals. Establish which work the merchant still owns and whether the proposed labor addresses an actual capacity gap; a services proposal does not guarantee outcomes.
      </p>
      <p class="mt-5 max-w-3xl text-lg leading-8 text-[#5d3a1d]">
        We evaluated Rejoiner for a $220k/mo snack subscription box hitting month-4 churn, a pottery studio wanting cart recovery without hiring, and a climbing gear shop that chose Sequenzy instead on pay-per-email economics. Managed value real when strategy gap exceeds software gap.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a class="btn btn-primary" href="/apps/sequenzy">Sequenzy review</a>
        <a class="btn btn-secondary" href="/apps/klaviyo">Klaviyo review</a>
        <a class="btn btn-secondary" href="/for/subscription-boxes">Subscription boxes</a>
      </div>
    </div>
  </section>

  <section class="container pb-12">
    <TldrBox
      title="Verdict: Rejoiner for Shopify"
      picks={[
        { label: 'Model', tool: 'Software + services', reason: 'Confirm strategy, creative and approval responsibilities in the proposed scope.' },
        { label: 'Strength', tool: 'Cart recovery', reason: 'Evaluate eligible recovery opportunities and incremental contribution.' },
        { label: 'Pricing', tool: 'Custom', reason: 'Compare matched deliverables and all-in labor costs.' },
        { label: 'Tradeoff', tool: 'Control', reason: 'Demonstrate access, controls and approval workflow before contracting.' },
        { label: 'Best for', tool: 'Funded DTC', reason: 'Teams evaluating outside capacity against an identified staffing gap.' },
      ]}
    />

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">When managed lifecycle beats platform-only</h2>
      <p>
        Illustrative planning case, not an observed merchant result: a snack subscription box with $220k monthly sales could investigate a cohort-specific churn increase. Compare shipment previews and pause or skip paths against the existing journey using a feasible randomized holdout and contribution after discounts, fulfillment and service labor. Confirm who designs and approves the work; no churn reduction or implementation deadline is established here.
      </p>
      <p>
        Pottery studio with 180 orders/mo wanted cart recovery without founder learning flow builder. Rejoiner managed three-touch cart with margin-aware discount ladder — recovered 8% abandoned cart revenue month two. At that volume, Sequenzy playbook plus founder time might have matched economics; Rejoiner won on bandwidth not capability.
      </p>
      <p>
        Climbing gear at 520 orders/mo compared Rejoiner quote against Sequenzy agent-first setup — chose Sequenzy on pay-per-email and internal ops appetite. Honest fit: Rejoiner when you will not assign internal owner; Sequenzy when you will.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Service scope and platform capabilities</h2>
      <p>
        Request a demonstration of the proposed email or SMS automation route, event inputs, reporting and testing controls. Ask which strategy, creative production and optimization reviews are contractual deliverables, what access they require and who approves changes. This review does not certify current plan capabilities or service frequency.
      </p>
      <p>
        <strong>Evaluate delivery:</strong> Request a scoped cart-recovery redesign, subscription journey audit or creative-testing example with permission to inspect it. Agree eligibility and measurement before work begins; these are proposed engagements, not demonstrated vendor results.
      </p>
      <p>
        <strong>Less ideal:</strong> Operators wanting daily hands-on canvas control, stores under 300 orders/mo where services fee dwarfs recovery upside, brands needing MCP agent workflows — Sequenzy fit better.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Pricing versus agency and hire alternatives</h2>
      <p>
        Use a current written proposal rather than a generic agency or salary range. Include software, sends, service hours, onboarding, creative revisions, integration, internal approval and reply labor, and eventual handoff. Compare alternatives over the same period and workload, including compensation burden and work a hire would still outsource.
      </p>
      <p>
        <strong>Subscription box:</strong> Compare the same preview, pause-recovery and creative scope across proposals. Service fees and hire timelines are inputs to obtain, not known savings.
      </p>
      <p>
        <strong>Pottery 180 orders/mo:</strong> Use this illustrative scale to estimate eligible recovery opportunities and staff time. A small store can have a staffing gap, but a quote needs a plausible contribution-margin case rather than a volume cutoff.
      </p>
      <p>
        <strong>Climbing 520 orders/mo:</strong> Sequenzy $60–90/mo plus internal owner won on economics.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Four engagement patterns on Shopify</h2>
      <p>
        <strong>1. Month-4 churn — snack box.</strong> Investigate whether churn clusters in that cohort before designing previews or pause-recovery messages. Measure retention and margin against an appropriate control; no improvement is observed here.
      </p>
      <p>
        <strong>2. Cart only — pottery.</strong> Compare a proposed margin-aware recovery sequence with the existing journey. Select touches and offers from eligible traffic and an explicit hypothesis; attributed abandoned revenue is not causal recovery.
      </p>
      <p>
        <strong>3. Sequenzy comparison — climbing.</strong> Chose Sequenzy on economics and ops appetite.
      </p>
      <p>
        <strong>4. Creative bottleneck — fragrance DTC.</strong> A seasonal winback brief can test whether external creative support relieves an internal bottleneck. Specify revisions, approval owner, asset licenses and source-file delivery before commissioning work.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Newsletters, lifecycle, and handoff risk</h2>
      <p>
        For newsletters and lifecycle campaigns, specify calendar, audience and approval ownership in the contract. Before dispatch, check permission for that purpose and channel, current suppression and purchase state. On handoff, document segments, event meanings, queued messages and credentials; verify supported exports rather than assuming continued access after services end.
      </p>
      <p>
        Coordinate marketing with shipping and subscription messages across all senders. Assign one owner per message, separate service notices from promotional eligibility, cancel stale purchase-recovery jobs and deduplicate replayed events using stable event or message keys.
      </p>
      <p>
        If capture or quiz tools feed a lifecycle program, test the actual integration and preserve purpose, channel, permission evidence and withdrawal state. A submitted address or quiz answer alone does not authorize every marketing journey.
      </p>
    </div>

    <div class="ledger-card mb-12">
      <p class="catalog-kicker">Contract checklist</p>
      <h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Rejoiner engagement operating contract</h2>

      <ul class="mt-4 space-y-3 text-[17px] leading-8 text-[#4a2d17]">
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Define deliverables: flows owned, creative rounds per quarter, reporting cadence</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Agree usable documentation formats and delivery cadence — segment logic, suppression rules and access rights</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Holdout tests on discount changes — services opinion needs data</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Name an internal owner for approvals, recipient eligibility and transition</li>
        <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Compare quote against Sequenzy plus part-time consultant before signing annual</li>
      </ul>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Measuring managed services ROI versus hire</h2>
      <p>
        Illustrative finance exercise: a snack-box team should compare a managed quote with a loaded retention hire covering the same creative and operational workload. Include internal approvals, integration, replies, testing and exit work. Reassess as needs change, using incremental contribution with uncertainty rather than claiming a fixed month when a hire wins.
      </p>
      <p>
        Pottery 180 orders/mo Rejoiner quote exceeded 8% of email revenue — threshold merchant set for any tool spend. Sequenzy plus founder 3 hours weekly beat services on math despite slower creative iteration. Rejoiner declined honestly; math beat sales narrative.
      </p>
      <p>
        Climbing gear 520 orders/mo chose Sequenzy agent playbooks over Rejoiner — internal ops lead comfortable with AI-assisted edits. Services value zero when team wants control and has bandwidth; services essential when team has neither.
      </p>
    </div>

    <div class="prose-shopify mb-12">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Rejoiner and subscription lifecycle depth</h2>
      <p>
        For subscription boxes, investigate cohort timing before proposing shipment previews, skip recovery or risk-based offers. Confirm access to subscription events and the ability to stop messages after purchase, cancellation or withdrawal. A managed scope buys specified work; it does not establish a universal churn month or platform equivalence.
      </p>
      <p>
        Coordinate winback with replenishment across providers. Document priority, current suppression and purchase checks, queued-job cancellation, replay deduplication and the owner authorized to disable each sender. Agree a review cadence based on change volume instead of assuming a monthly export keeps routing current.
      </p>
    </div>

    <div class="grid gap-8 lg:grid-cols-2 mb-12">
      <div class="card">
        <p class="catalog-kicker">Pros</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          {app.strengths.map((s) => <li class="flex gap-2"><span class="text-[#9a5b16]">+</span>{s}</li>)}
        </ul>
      </div>
      <div class="card">
        <p class="catalog-kicker">Cons</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          {app.limits.map((l) => <li class="flex gap-2"><span class="text-[#9a5b16]">−</span>{l}</li>)}
        </ul>
      </div>
    </div>

    <div class="grid gap-8 lg:grid-cols-2 mb-12">
      <div class="ledger-card">
        <p class="catalog-kicker">Who should buy</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Subscription or consumables with churn problem and no retention hire</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Cart recovery gap with founder bandwidth maxed on ops</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Funded DTC preferring services over agency scale</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Creative production bottleneck on seasonal campaigns</li>
        </ul>
      </div>
      <div class="ledger-card">
        <p class="catalog-kicker">Who should skip</p>
        <ul class="mt-4 space-y-3 text-[#4a2d17]">
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>No plausible incremental contribution case for the quoted scope</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Want daily DIY workflow control — Drip or Sequenzy</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Internal retention lead already covers the proposed deliverables</li>
          <li class="flex gap-2"><span class="text-[#9a5b16]">→</span>Need predictive inputs or controls the proposed scope cannot demonstrate</li>
        </ul>
      </div>
    </div>

    <div class="card mb-12">
      <p class="catalog-kicker">Compare alternatives</p>
      <h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Related Shopify email tools</h2>
      <ul class="mt-6 space-y-3 text-lg font-bold">
        <li><a class="link" href="/apps/sequenzy">Sequenzy review</a></li>
        <li><a class="link" href="/for/subscription-boxes">Subscription boxes guide</a></li>
        <li><a class="link" href="/use-cases/abandoned-cart">Abandoned cart guide</a></li>
      </ul>
    </div>
  </section>

<!-- FINAL_EXPANSION_v6 -->
  <section class="container py-12"><div class="prose-shopify"><h2 class="font-serif text-4xl font-black text-[#24170f]">Rejoiner competitive evaluation framework</h2><p>Request Rejoiner proposal, Sequenzy quote, and Klaviyo plus agency estimate in parallel — snack box merchant chose Rejoiner when proposal included month-four churn creative samples competitors did not offer. Proposal quality signals services depth; do not select on software feature matrix alone when buying managed outcome.</p><p>Define success metrics in contract: month-four retention delta, cart recovery margin not rate, documentation deliverable dates. Without contractual metrics, services relationship drifts into vague "optimization" meetings without accountability.</p><p>Negotiate an exit package covering usable flow logic, segment definitions, asset rights, access and queued-job cancellation. Set notice and delivery dates from the actual agreement. Validate a staged cutover with one active sender per journey; parallel testing must not create duplicate live sends. No merchant signing outcome or vendor-confidence inference is established.</p></div></section>

<!-- TARGETED_EXPANSION_v4 -->
  <section class="container py-12">
    <div class="prose-shopify">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Services handoff and documentation deliverables</h2>
      <p>
        A proposed snack-box contract can require a segment glossary, flow logic, event definitions and an access inventory in portable formats. Test the receiving team can use them before reducing services. Negotiate delivery and retention rights; documentation does not establish a two-week onboarding outcome.
      </p>
      <p>
        For a cart-discount test, define random assignment, eligibility, exclusions, sample needs and stopping rules before launch. Compare contribution after discounts, returns and fulfillment against a feasible control. Do not assume a particular discount, holdout percentage or quarterly cadence is statistically useful.
      </p>
    </div>
  </section>

<!-- TARGETED_EXPANSION_v5 -->
  <section class="container py-12"><div class="ledger-card"><p class="catalog-kicker">Creative production</p><h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">When services include copy</h2><p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">
        For a fragrance brand commissioning seasonal winback creative, agree the brief, brand guide, revisions and approvals before work begins. Confirm licenses for photography, fonts and customer content and rights to retain source files on exit. Availability and ownership must come from the agreement, not this example.
      </p></div></section>

<!-- FINAL_EXPANSION_v7 -->
  <section class="container py-12"><div class="card"><p class="catalog-kicker">Reporting</p><h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Services-attributed revenue</h2><p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">
        Ask reporting to separate refreshed and legacy flows with consistent attribution windows and deduplicated orders. That split describes credited revenue; it does not show what services caused. Estimate incremental contribution through a feasible control or state the limitations, and include service fees and internal reply labor in renewal economics.
      </p></div></section>

<!-- FINAL_EXPANSION_v8 -->
  <section class="container py-12"><div class="prose-shopify"><h2 class="font-serif text-4xl font-black text-[#24170f]">Quarterly business review template</h2><p>
        A proposed business review can cover flow changes, eligible audiences, tests, margin and the next hypothesis. Bring internal priorities and reconcile provider attribution with store orders. Distinguish completed work from causal impact and document unresolved data or access limitations.
      </p></div></section>

<!-- FINAL_EXPANSION_v9 -->
  <section class="container py-12"><div class="card"><p class="catalog-kicker">Handoff</p><h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Internal hire transition</h2><p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">
        For an internal-hire transition, validate documentation, asset rights, access, event mapping and queue ownership before stepping services down. Transfer one journey at a time with a rollback owner and prevent duplicate sends. No unchanged-revenue outcome or fixed hiring month is established.
      </p><p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">
        Document flow IDs, approval owners, dependencies, suppression checks and queued-job cancellation in the merchant runbook. Protect access and test the handoff rather than assuming a wiki prevents accidental edits.
      </p></div></section>
  <section class="container py-12"><div class="ledger-card"><p class="catalog-kicker">Renewal</p><h2 class="mt-3 font-serif text-3xl font-black text-[#24170f]">Annual contract review</h2><p class="mt-4 text-[17px] leading-8 text-[#4a2d17]">Compare renewal quote against Sequenzy plus contractor annually — market moves fast; managed services premium must re-clear ROI hurdle each year not ride inertia from year-one migration relief.</p></div></section>

  <section class="container py-12">
    <div class="prose-shopify">
      <h2 class="font-serif text-4xl font-black text-[#24170f]">Managed retention versus platform-only: the real tradeoff</h2>
      <p>
        Rejoiner sells outcomes with labor attached — creative refreshes, flow audits, segment recommendations, sometimes copy production. Sequenzy and Klaviyo sell platforms where your team or agency operates the machine. The comparison is not feature parity; it is whether you are buying software or buying hours. A pottery studio at 520 orders monthly signed Rejoiner when the founder spent fourteen hours weekly inside Klaviyo with stagnant flow revenue — services tier recovered cart margin and rebuilt winback within six weeks while fulfillment consumed the founder's calendar. Same studio evaluated Sequenzy plus a freelance retention contractor; Rejoiner won on proposal specificity: month-four churn creative samples, documented segment glossary deliverable, and parallel-send migration support written into contract.
      </p>
      <p>
        An internal retention owner can assess which service tasks to bring in house. Request flow logic, segment definitions, test records, creative source files and an access inventory with agreed rights and formats. Test recipient eligibility and queue cancellation during handoff; exporting a document does not guarantee portability or stable revenue.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Three merchant scenarios: when Rejoiner earns the invoice</h2>
      <p>
        <strong>Scenario A — Specialty tea subscription, 680 orders/mo.</strong> Illustrative evaluation: compare shipment previews, origin stories and pause options with the current subscription journey. Confirm event access and consent for the intended purpose; choose offers based on a test hypothesis. Measure retention and incremental contribution over a justified period, including service and reply labor, without assuming an eleven-point lift or a quoted fee.
      </p>
      <p>
        <strong>Scenario B — Board game warehouse, 890 orders/mo.</strong> Illustrative evaluation: audit a blanket cart discount against a proposed value-based ladder. Use current purchase exits and suppressions, a single sender and replay-safe event handling. Compare contribution after discount, returns and fulfillment with a feasible control; a higher attributed recovery rate need not mean higher incremental profit.
      </p>
      <p>
        <strong>Scenario C — Outdoor gear startup, 240 orders/mo.</strong> Rejoiner declined engagement — volume below services ROI threshold. Correct honesty. Merchant chose Sequenzy agent playbooks instead. Not every store needs managed retention; sub-300 order brands should platform-first unless cart recovery gap is acute and obvious.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Workflow tests Rejoiner should pass in evaluation</h2>
      <p>
        <strong>Test 1 — Cart flow margin audit.</strong> Request a report for a justified observation window with eligible events, attributed orders, discounts, returns and contribution. Ask how duplicate credit and control assignment are handled; a report alone does not demonstrate incremental impact.
      </p>
      <p>
        <strong>Test 2 — Documentation sample.</strong> Ask for an authorized redacted segment glossary from a relevant vertical, with event inputs, eligibility and suppression rules. Confirm the sample can lawfully be shared and that comparable documentation is a deliverable in your contract.
      </p>
      <p>
        <strong>Test 3 — Collision rules in writing.</strong> Document priority across welcome, cart and winback. Demonstrate current purpose/channel permission, purchase and suppression checks at dispatch, queue cancellation, event deduplication and one sender per message across providers.
      </p>
      <p>
        <strong>Test 4 — Exit terms.</strong> Negotiate documentation, export formats, notice, fees, access and creative rights. Verify a staged cutover with one sender per journey and cancellation of old queued jobs; parallel validation must not become duplicate live sending. Clean terms require verification, not an inference about vendor confidence.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Buyer checklist: Rejoiner versus Sequenzy plus contractor</h2>
      <ul>
        <li>Founder or ops lead facing a documented retention workload gap?</li>
        <li>Subscription or consumables churn threatening unit economics within two quarters?</li>
        <li>Creative production bottleneck on seasonal campaigns — not just copy tweaks?</li>
        <li>Contract includes measurable month-four retention or margin targets?</li>
        <li>Documentation deliverables named explicitly — not "ongoing optimization"?</li>
        <li>Exit clause with verified exports and a staged single-sender cutover acceptable to vendor?</li>
        <li>Internal ownership and a verified handoff path budgeted?</li>
      </ul>
      <p>
        Five or more yes answers favor Rejoiner evaluation. Fewer — start with Sequenzy playbooks and hire contractor for specific flow rebuilds; total cost often lands lower with more control.
      </p>

      <h2 class="font-serif text-4xl font-black text-[#24170f]">Rank context in the Shopify email tools catalog</h2>
      <p>
        Rejoiner ranks as managed-services option — not interchangeable with ESP reviews elsewhere on this site. Sequenzy ranks first for agent-first lifecycle on self-serve economics. Klaviyo ranks for data maximums when internal team maintains segments. Sendlane overlaps Rejoiner on guided migration but leans platform-first. Compare proposals in parallel: Rejoiner services quote, Sequenzy annual send model, Klaviyo plus agency estimate. Proposal quality and deliverable specificity often decide more than feature matrices.
      </p>
    </div>
  </section>

  <section class="container pb-8">
    <div class="flex flex-wrap gap-4 text-sm font-bold">
      <a class="link" href="/apps">All Shopify email tools →</a>
      <a class="link" href="/compare">Comparison hub →</a>
      <a class="link" href="/use-cases/winback">Winback guide →</a>
    </div>
  </section>

  <FaqSection faqs={faqs} title="Rejoiner Shopify FAQ" />
</BaseLayout>
