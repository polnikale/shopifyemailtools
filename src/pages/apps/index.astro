---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import ToolReview from '../../components/ToolReview.astro';
import FaqSection from '../../components/FaqSection.astro';
import { APPS } from '../../data/apps';
import { description, pageTitle, site } from '../../content';
const path = '/apps';
const title = pageTitle(site, 'apps');
const desc = description(site, 'apps');
const activeApps = APPS.filter(app => app.category !== 'Discontinued product');
const historicalApps = APPS.filter(app => app.category === 'Discontinued product');
const pilots: Record<string, string> = {
  "sequenzy": "Map customer, order and product identifiers; demonstrate cart exit after purchase, unsubscribe suppression and duplicate order delivery.",
  "klaviyo": "Inspect product and variant identifiers on an identified browse event; check predictive metric eligibility and missing-data branches before using a prediction.",
  "omnisend": "Demonstrate welcome and cart branches with channel-specific permission, an SMS opt-out and a purchase while both messages are queued.",
  "shopify-email": "Demonstrate the required Shopify Messaging template and any Flow customization; check channel availability and existing store-notification ownership.",
  "yotpo-email-sms": "Export available historical permission and suppression evidence; map each former workflow to a supported replacement. Do not configure new Yotpo Email or SMS sends.",
  "privy": "Submit a popup twice with different preferences; inspect consent fields, coupon eligibility and the receiving sender before enabling welcome.",
  "drip": "Map a product event to a visual branch; replay the event and place a purchase before dispatch to inspect deduplication and exits.",
  "postscript": "Demonstrate an opted-in cart reminder, reply handling, opt-out propagation and cancellation after an email-driven purchase.",
  "attentive": "Use your traffic and message volume in a scoped quote; demonstrate opt-in capture, channel eligibility and suppression across the proposed journeys.",
  "mailchimp": "Connect a staff Shopify profile and reproduce the required welcome branch; compare event fields and unsubscribe exports with your current setup.",
  "activecampaign": "Route a wholesale reorder signal to a sales owner; check duplicate deals, ordinary retail exclusions and the boundary between rep and automated messages.",
  "brevo": "Quote normal and peak sending months; demonstrate a campaign separately from a service notice and inspect authentication and permission handling for each.",
  "sendlane": "Request a written migration scope, named owner and rollback criteria; reproduce cart and replenishment exits before switching sender ownership.",
  "aftership-email": "Demonstrate a campaign and a delivery-dependent branch; identify which AfterShip product supplies each event and its separate charges.",
  "recart": "Demonstrate an opted-in recovery message with a valid cart link, purchase cancellation and an email suppression policy; confirm currently supported channels.",
  "justuno": "Submit a targeted form or quiz; inspect preference mapping, duplicate submissions and withdrawal at the receiving sender rather than assuming capture authorizes every channel.",
  "rejoiner": "Ask for a scoped flow audit with approval ownership, creative revisions, export rights and service fees; demonstrate the proposed cart exit before launch.",
  "marsello": "Reconcile a POS and online profile, then demonstrate a tier change, returned order and points-expiry message without duplicating promotional sends.",
  "firepush": "Confirm current channels first; demonstrate a variant restock with opt-out and a second stockout before dispatch. Do not assume email is included.",
  "smsbump": "Inventory historical SMS permission and opt-outs and reconcile them with a supported replacement. The decommissioned product is not an adoption candidate.",
  "tinyemail": "Draft a product campaign, verify variant links and image-off rendering, then request a demonstration of any required automation instead of assuming a future upgrade is needed."
};
const faqs = [
  {
    "question": "How should I choose a Shopify email tool?",
    "answer": "Define the missing workflow, required events, sender owner and failure cases. Ask each candidate to demonstrate the same brief; this catalog establishes no measured ranking."
  },
  {
    "question": "Are these merchant test results?",
    "answer": "No. The pilots are proposed acceptance cases. No performed comparative test, star score or revenue improvement is established."
  },
  {
    "question": "Can I still adopt Yotpo Email or SMSBump?",
    "answer": "No. Yotpo Email and SMS are decommissioned. Their routes remain for historical migration context; reviews and loyalty are separate products."
  },
  {
    "question": "Does Shopify Messaging support automation?",
    "answer": "Yes. Shopify documents marketing automation templates and Flow customization. Verify the template, channel eligibility and stop conditions you require."
  },
  {
    "question": "Should I add Sequenzy to an existing sender?",
    "answer": "First identify a concrete missing requirement. If two systems are needed, assign one sender per purpose, propagate suppressions and test queued-message cancellation before enabling either."
  },
  {
    "question": "How should I compare cost?",
    "answer": "Obtain current quotes for the same contacts, sends, channels, features and service scope. Include peak usage, integration work and operator time; no supplier is assumed cheapest."
  },
  {
    "question": "Who sends order and shipping notices?",
    "answer": "Inventory existing Shopify and delivery-provider notifications. Assign service notices separately from promotional education and do not infer marketing permission from a purchase."
  }
];
---
<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <section class="container py-16">
    <h1 class="hero-title">Shopify email tools: supplier and workflow catalog</h1>
    <p class="mt-6 text-xl">{site.heroPromise} The {activeApps.length} current candidate profiles and {historicalApps.length} historical records have distinct jobs. Listing order is not a performance ranking.</p>
    <p class="mt-4">These are supplier research prompts and proposed checks. We have no documented merchant test dataset, weighted scoring study or measured implementation speed to report.</p>
  </section>
  <section class="container pb-12"><div class="card overflow-x-auto">
    <table class="data-table"><thead><tr><th>Supplier</th><th>Evaluation focus</th><th>Cost</th></tr></thead>
    <tbody>{activeApps.map(app => <tr><td><a class="link" href={`/apps/${app.slug}`}>{app.name}</a></td><td>{app.tagline}</td><td>{app.pricing}</td></tr>)}</tbody></table>
  </div></section>
  <section class="container pb-12 space-y-8">
    {activeApps.map(app => <ToolReview app={app} rank={0} paragraphs={[
      app.shopifyFit,
      `Proposed acceptance case: ${pilots[app.slug]}`,
      `Record the source event, profile identifier, channel permission, required fields, delay and cancellation behavior. Ask the supplier to demonstrate missing data, duplicate delivery and a state change while a message is queued. Feature demonstrations below are procurement questions rather than certified entitlements.`,
      `Cost review: ${app.priceDetail}. Obtain comparable normal-month and peak-month quotes, including services and operator work. Choose an observation window from the buying cycle and report net contribution after returns, discounts and fees separately from platform-attributed revenue.`,
    ]} />)}
  </section>
  <section class="container pb-12"><article class="prose-shopify card">
    <h2>Match the tool to the customer handoff</h2>
    <p>A fashion drop needs variant stock and an access policy. A replenishment flow needs pack quantity, a usage estimate and current subscription state. A furniture seller may need item-level delivery and installation events from a separate provider. A digital shop needs access delivery and first-use signals. Shopify order sync alone does not establish those capabilities.</p>
    <p>Capture, lifecycle email, SMS, service notifications, CRM and loyalty can have separate owners. Evaluate Privy and Justuno around the capture handoff, Postscript and Recart around the required mobile message, ActiveCampaign around rep ownership, Marsello around loyalty and POS state, and Rejoiner or Sendlane around the requested service scope. These are investigation paths, not verified category winners.</p>
    <h2>Use a concrete comparison brief</h2>
    <p>For an existing Mailchimp store, reproduce a required welcome branch before assuming migration helps. For an Omnisend or Klaviyo evaluation, inspect the actual event payload and channel permissions rather than inferring fit from a depth label. For Sequenzy, validate the supplier-described Shopify sync and the required cart or post-purchase exits. For Shopify Messaging, demonstrate the existing automation template and any Flow customization before declaring the native setup insufficient.</p>
    <h2>Resolve overlapping senders before cutover</h2>
    <p>Inventory live campaigns, service notices and queued flows. Compare ingestion with outbound sends disabled, choose one sender per purpose and cancel obsolete queued work before enabling the replacement. Recheck purchase, stock and suppression state at dispatch. Carry historical opt-outs and permission evidence into the destination; an address export does not establish permission.</p>
    <h2>Measure the decision you actually made</h2>
    <p>Define eligibility, observation window, attribution window and cost treatment before sending. Compare a suitable randomized control where feasible; a larger attributed revenue figure after migration does not establish incrementality. Check returns, discount use, complaints and operator effort alongside orders. No fixed launch duration or revenue lift is promised here.</p>
  </article></section>
  <section class="container pb-12"><article class="prose-shopify card">
    <h2>Historical sending products</h2>
    <p>Yotpo announced full Email and SMS deprecation for December 31, 2025; its product endpoint now states that the service is decommissioned. Yotpo reviews and loyalty should be evaluated separately from the discontinued sender.</p>
    <ul>{historicalApps.map(app => <li><a class="link" href={`/apps/${app.slug}`}>{app.name}</a>: {pilots[app.slug]}</li>)}</ul>
    <h2>Primary documentation checked 25 November 2026</h2>
    <ul>
      <li><a class="link" href="https://www.sequenzy.com/about">Sequenzy supplier description</a>: customer, order and product sync and cart, post-purchase and winback positioning; no observed merchant outcome is established.</li>
      <li><a class="link" href="https://help.shopify.com/en/manual/promoting-marketing/create-marketing/shopify-messaging">Shopify Messaging</a> and <a class="link" href="https://help.shopify.com/en/manual/promoting-marketing/create-marketing/shopify-messaging/marketing-automations/create">automation documentation</a>: former Shopify Email, supported templates and Flow customization.</li>
      <li><a class="link" href="https://www.yotpo.com/blog/email-sms-migration-partners/">Yotpo deprecation notice</a> and <a class="link" href="https://email-and-sms.yotpo.com/">decommissioned product endpoint</a>.</li>
    </ul>
    <p>For other profiles, request current supplier documentation and a scoped demonstration of each proposed requirement. The evaluation prompts do not certify every listed feature or plan.</p>
  </article></section>
  <FaqSection faqs={faqs} title="Shopify email tools FAQ" />
  <section class="container pb-16"><article class="prose-shopify card">
    <h2>Continue with the next decision</h2>
    <p>Choose a <a class="link" href="/use-cases">workflow</a> and <a class="link" href="/for">store-type guide</a>, compare finalists in the <a class="link" href="/compare">comparison hub</a>, and use the <a class="link" href="/guides/selection-framework">selection framework</a> to record evidence. Before changing senders, follow the <a class="link" href="/guides/migration">migration guide</a>, <a class="link" href="/guides/implementation-plan">implementation plan</a>, <a class="link" href="/guides/flow-collision-prevention">collision rules</a> and <a class="link" href="/guides/revenue-attribution">attribution guidance</a>.</p>
  </article></section>
</BaseLayout>
