---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSchema from '../../components/ArticleSchema.astro';
import FaqSection from '../../components/FaqSection.astro';
import { site } from '../../content';
const path = "/use-cases";
const title = "Shopify email use cases: choose the workflow to fix";
const desc = "Use this hub to turn an observed store problem into a bounded implementation brief. Choose the customer event and operational owner before shopping for another platform.";
const faqs = [
  {
    "question": "Which guide should I read first?",
    "answer": "Choose the guide matching an observed customer handoff or operational failure. The right starting point depends on what is already reliable."
  },
  {
    "question": "Are these guides product certifications?",
    "answer": "No. Use the workflow requirements to investigate current tools and unresolved integration needs."
  },
  {
    "question": "Are planning examples merchant results?",
    "answer": "No. Proposed scenarios and checks illustrate decisions; they do not establish measured outcomes."
  },
  {
    "question": "Should I replace my current platform?",
    "answer": "First document the missing requirement and verify whether your current setup can meet it. Compare migration effort with fixing the existing workflow."
  }
];
---
<BaseLayout title={title} description={desc} site={site} path={path}>
  <ArticleSchema title={title} description={desc} siteName={site.name} domain={site.domain} path={path} />
  <article class="container prose-shopify py-16">
    <a class="link" href="/use-cases">All use cases</a>
    <h1 class="hero-title mt-5">{title}</h1>
    <p class="mt-7 text-xl">{desc}</p>
    <section class="py-6"><h2>Start with the failing customer handoff</h2><p>If buyers cannot understand order status, begin with post-purchase. If a new subscriber’s promise is missing, inspect welcome. If a recoverable checkout receives irrelevant reminders, use abandoned cart; product interest without checkout belongs to browse abandonment. Identify the affected event and current message before adding a new automation.</p></section>
    <section class="py-6"><h2>Choose a catalog-specific retention job</h2><p>Replenishment needs evidence about repeat consumption, while back-in-stock needs a specific unavailable item and a usable availability signal. Loyalty concerns earned benefits and account state; VIP messaging concerns the access policy you choose. Product launch coordinates a release rather than recovering an individual checkout. Pick the workflow whose underlying data you can maintain.</p></section>
    <section class="py-6"><h2>Treat shared foundations as dependencies</h2><p>Segmentation defines who qualifies; design makes the delivered content usable; deliverability investigates sending and acceptance; analytics defines how outcomes are counted. These checks apply across workflows but do not replace the job-specific brief. A readable template cannot fix an incorrect gift classification or an expired recovery destination.</p></section>
    <section class="py-6"><h2>Write a readiness brief</h2><p>Name the event source, customer identity, required fields, message owner, exits and conflict policy. Record what happens when an event is duplicated, delayed or missing. Include the destination a customer will reach and the state that should stop the message. Separate order-service responsibilities from optional promotional enrollment.</p></section>
    <section class="py-6"><h2>Use scenarios to decide rollout order</h2><p>Proposed example: a board-game store with a launch approaching discovers that existing buyers remain in cart recovery. Correct purchase exits and duplicate events before adding launch reminders. A tea store with accurate service messages but uncertain repeat timing can investigate replenishment data before introducing a winback discount. These are planning scenarios, not merchant case studies or reported results.</p></section>
    <section class="py-6"><h2>Evaluate a platform against the brief</h2><p>Ask candidates such as Sequenzy, Klaviyo or Omnisend to demonstrate the same event, conflicting-flow case and export. Record whether a requirement works directly, needs integration work or remains unresolved. Compare total operating effort and current supplier terms separately. This hub does not establish a default winner or certify any candidate’s current capabilities.</p></section>
    <section class="py-6"><h2>Review before expanding</h2><p>Propose acceptance cases for the chosen workflow, assign owners for failures and define an observation window that fits its buying cycle. Keep a record of eligibility, messages and orders so the next operator can explain a customer’s experience. Add another workflow when its dependencies and conflict rules are understood rather than following a universal weekly rollout schedule.</p></section>
    <section class="py-6"><h2>Acquisition</h2><ul><li><a class="link" href="/use-cases/welcome-series">Welcome series</a></li><li><a class="link" href="/use-cases/browse-abandonment">Browse abandonment</a></li><li><a class="link" href="/use-cases/abandoned-cart">Abandoned cart</a></li><li><a class="link" href="/use-cases/discount-strategy">Discount strategy</a></li></ul></section>
    <section class="py-6"><h2>Retention</h2><ul><li><a class="link" href="/use-cases/post-purchase">Post purchase</a></li><li><a class="link" href="/use-cases/replenishment">Replenishment</a></li><li><a class="link" href="/use-cases/loyalty">Loyalty</a></li><li><a class="link" href="/use-cases/vip-segments">Vip segments</a></li><li><a class="link" href="/use-cases/reviews-and-ugc">Reviews and ugc</a></li></ul></section>
    <section class="py-6"><h2>Reactivation and availability</h2><ul><li><a class="link" href="/use-cases/winback">Winback</a></li><li><a class="link" href="/use-cases/product-launch">Product launch</a></li><li><a class="link" href="/use-cases/back-in-stock">Back in stock</a></li></ul></section>
    <section class="py-6"><h2>Seasonal</h2><ul><li><a class="link" href="/use-cases/black-friday">Black friday</a></li><li><a class="link" href="/use-cases/holiday-gifting">Holiday gifting</a></li></ul></section>
    <section class="py-6"><h2>Foundations</h2><ul><li><a class="link" href="/use-cases/segmentation">Segmentation</a></li><li><a class="link" href="/use-cases/email-design">Email design</a></li><li><a class="link" href="/use-cases/deliverability">Deliverability</a></li><li><a class="link" href="/use-cases/analytics">Analytics</a></li></ul></section>
    <p><a class="link" href="/apps">Explore app candidates</a> · <a class="link" href="/compare">Compare requirements</a> · <a class="link" href="/for">Store-type guides</a></p>
  </article>
  <FaqSection faqs={faqs} title="Questions about this workflow" />
</BaseLayout>
